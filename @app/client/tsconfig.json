{
  "extends": "../../tsconfig.json",
  "include": ["src"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "baseUrl": ["."],
      "~/*": ["./src/*"],
      "~/ui": ["./src/components/ui"],
      "~/typography": ["./src/components/typography"]
    }
  },
  "types": ["vite/client"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
