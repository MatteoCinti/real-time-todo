{
  "name": "@app/server",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . --ext .ts",
    "build": "swc src --out-dir dist",
    "start": "node dist/src/server.js",
    "dev": "nodemon",
    "dev:windows": "nodemon --legacy-watch",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "NODE_ENV=test pnpm codegen && jest --watch",
    "db:create": "sequelize db:create",
    "db:migrate": "sequelize db:migrate"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@sequelize/postgres": "7.0.0-alpha.41",
    "@swc/helpers": "^0.5.11",
    "@types/pg": "^8.11.6",
    "apollo-server": "^3.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "graphql": "^16.9.0",
    "graphql-subscriptions": "^2.0.0",
    "@graphql-tools/schema": "^10.0.6",
    "graphql-ws": "^5.16.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "mysql2": "^3.10.3",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.2",
    "@graphql-codegen/introspection": "4.0.3",
    "@graphql-codegen/typescript": "4.0.9",
    "@graphql-codegen/typescript-document-nodes": "4.0.9",
    "@graphql-codegen/typescript-resolvers": "^4.2.1",
    "@graphql-tools/mock": "^9.0.4",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.6.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^18.14.0",
    "@types/ws": "^8.5.12",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2",
    "ts-jest": "^29.2.4",
    "tsx": "^4.15.7"
  }
}
