{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["es2020"],
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "baseUrl": ["."],
      "~/*": ["./src/*"],
      "~/graphql": ["./src/providers/graphql"]
    }
  },
  "include": ["/**/*.ts"]
}
